{
	debug

	savefile {
		root_dir /var/uploads
		max_size 1MB
		max_parts 6
		temp_dir /tmp
	}
}

http://127.0.0.1:8080 {
	root * /srv/e2e

	handle /upload* {
		formdata

		savefile image/* images/{uuid}_{filename}
		savefile application/pdf docs/{uuid}_{filename}

		respond "{{include \"/process.html\"}}" 200

		templates {
			extensions {
				savefile
			}
		}
	}

	file_server
}
